#!/usr/bin/env python3
"""
check — which claude-code-orchestrator release this project's copy came from.

Usage: check [--check-latest]
       check --plan PROJECT [--from X.Y.Z] [--to X.Y.Z]
  (no flag)       the installed version, from .claude/ORCHESTRATOR_VERSION.
                  No network.
  --check-latest  also the newest release upstream and the changelog entries
                  since the installed one. Needs network to GitHub; if that
                  fails (company proxies block it often) it says so and exits 0.
  --plan PROJECT  read-only upgrade plan for the copy in PROJECT. Run THIS
                  script from a template clone with its tags (the project's
                  own copy is the old version). The old version is PROJECT's
                  .claude/ORCHESTRATOR_VERSION (or --from), the new one the
                  highest vX.Y.Z tag of the clone (or --to). Prints a class per
                  file and changes nothing. Exit 2 when a precondition fails.

Environment (for forks and tests):
  ORCHESTRATOR_UPSTREAM       git URL or path of the template repository
  ORCHESTRATOR_CHANGELOG_URL  URL of its CHANGELOG.md (file:// works)
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path
from typing import NamedTuple

DEFAULT_UPSTREAM = "https://github.com/GunwooYun/claude-code-orchestrator.git"
DEFAULT_CHANGELOG = "https://raw.githubusercontent.com/GunwooYun/claude-code-orchestrator/main/CHANGELOG.md"
TIMEOUT_S = 15
TAG = re.compile(r"refs/tags/v(\d+)\.(\d+)\.(\d+)$")
ENTRY = re.compile(r"^## \[(\d+)\.(\d+)\.(\d+)\]", re.MULTILINE)

# .claude/skills/orchestrator-version/check -> .claude/ -> repository root
CLAUDE_DIR = Path(__file__).resolve().parents[2]
TEMPLATE_ROOT = CLAUDE_DIR.parent
SEMVER = re.compile(r"(\d+)\.(\d+)\.(\d+)")

# What a copy carries (README Quick Start), and what a plan compares.
PLAN_SCOPE = (".claude", ".agents", "CLAUDE.md")
# Runtime state a project accumulates. Never shipped, never part of a plan.
RUNTIME_PREFIXES = (
    ".claude/logs/",
    ".claude/docs/reviews/",
    ".claude/isolated-review/",
)
RUNTIME_FILES = (".claude/settings.local.json",)
COMPILED_SUFFIXES = (".pyc", ".pyo", ".pyd")
HOOKS_DIR = ".claude/hooks/"
SETTINGS = ".claude/settings.json"
ADD_SCRIPT_NOTE = "(script: allow it in settings.json permissions where it is called)"
# Project-owned files, spelled exactly as README §9 「업그레이드 절차」 lists them:
# relative to .claude/ unless they are CLAUDE.md or start with .agents/.
PROJECT_OWNED = (
    "CLAUDE.md",
    "rules/dev-environment.md",
    "rules/testing.md",
    "rules/test-writing.md",
    "scripts/verify-*",
    "settings.json",
    ".agents/rules/AGENTS.md",
    "docs/DESIGN.md",
    "docs/research/",
)
CLASSES = (
    ("REPLACE", "unmodified in the project, changed upstream: take the new file"),
    (
        "MERGE",
        "changed by the project AND upstream: take the new file, re-apply the "
        "project's edits",
    ),
    ("KEEP", "changed by the project, not upstream: leave it"),
    ("DELETE", "gone upstream, unmodified in the project: delete it"),
    ("DELETE-MODIFIED", "gone upstream, but the project changed it: decide"),
    ("ADD", "new upstream: add it"),
    (
        "ABSENT",
        "shipped in both versions, missing in the project: add it back, or "
        "confirm it was removed on purpose",
    ),
    (
        "PROJECT-ONLY",
        "not shipped in the old version: leftovers of older releases, or the "
        "project's own files",
    ),
)
OWNED_NOTE = (
    "[project-owned] = do not overwrite; apply what the CHANGELOG says changed by hand"
)


class PlanError(Exception):
    """A --plan precondition failed; the message tells the user what to do."""


class Blob(NamedTuple):
    mode: str
    sha: str


def parse_version(text: str) -> tuple[int, int, int] | None:
    m = SEMVER.fullmatch(text.strip())
    return (int(m[1]), int(m[2]), int(m[3])) if m else None


def installed(claude_dir: Path = CLAUDE_DIR) -> tuple[int, int, int] | None:
    try:
        text = (claude_dir / "ORCHESTRATOR_VERSION").read_text(encoding="utf-8")
    except OSError:
        return None
    return parse_version(text)


def fmt(version: tuple[int, int, int]) -> str:
    return ".".join(str(p) for p in version)


def latest_release(upstream: str) -> tuple[int, int, int]:
    """Highest vX.Y.Z tag, compared numerically. Raises RuntimeError on failure."""
    try:
        out = subprocess.run(
            ["git", "ls-remote", "--tags", "--refs", upstream],
            capture_output=True,
            text=True,
            timeout=TIMEOUT_S,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise RuntimeError(f"cannot reach {upstream}: {exc}") from exc
    if out.returncode != 0:
        raise RuntimeError(f"cannot reach {upstream}: {out.stderr.strip()[:200]}")
    versions = [
        (int(m[1]), int(m[2]), int(m[3]))
        for line in out.stdout.splitlines()
        if (m := TAG.search(line.split("\t")[-1]))
    ]
    if not versions:
        raise RuntimeError(f"no vX.Y.Z release tags at {upstream}")
    return max(versions)


def newer_entries(changelog_url: str, since: tuple[int, int, int] | None) -> str:
    """Changelog sections newer than `since` (all of them when unknown)."""
    with urllib.request.urlopen(changelog_url, timeout=TIMEOUT_S) as response:
        text = response.read().decode("utf-8", errors="replace")
    starts = list(ENTRY.finditer(text))
    kept = []
    for i, m in enumerate(starts):
        version = (int(m[1]), int(m[2]), int(m[3]))
        end = starts[i + 1].start() if i + 1 < len(starts) else len(text)
        if since is None or version > since:
            kept.append(text[m.start() : end].rstrip())
    return "\n\n".join(kept)


def git(root: Path, *args: str) -> subprocess.CompletedProcess[bytes]:
    return subprocess.run(["git", "-C", str(root), *args], capture_output=True)


def release_tags(root: Path) -> list[tuple[int, int, int]]:
    out = git(root, "tag", "--list", "v*")
    if out.returncode != 0:
        raise PlanError(
            f"{root} is not a git repository — run this script from a clone of "
            "the template, not from a copy of .claude/"
        )
    versions = []
    for line in out.stdout.decode("utf-8", errors="replace").splitlines():
        m = SEMVER.fullmatch(line.strip()[1:])
        if line.startswith("v") and m:
            versions.append((int(m[1]), int(m[2]), int(m[3])))
    return sorted(versions, reverse=True)


def resolve_versions(
    project: Path, from_arg: str | None, to_arg: str | None
) -> tuple[tuple[int, int, int], tuple[int, int, int], str]:
    """(old, new, where old came from). Raises PlanError with the fix."""
    tags = release_tags(TEMPLATE_ROOT)
    fetch = f"`git -C {TEMPLATE_ROOT} fetch --tags`"
    if not tags:
        raise PlanError(f"{TEMPLATE_ROOT} has no vX.Y.Z tags — run {fetch}")
    in_file = installed(project / ".claude")
    if from_arg is not None:
        old = parse_version(from_arg)
        if old is None:
            raise PlanError(f"--from {from_arg}: expected X.Y.Z")
        source = "--from"
        if in_file is not None and in_file != old:
            source += f" (overrides the project's file, which says {fmt(in_file)})"
    elif in_file is not None:
        old, source = in_file, "the project's .claude/ORCHESTRATOR_VERSION"
    else:
        raise PlanError(
            f"{project} has no .claude/ORCHESTRATOR_VERSION — pass --from X.Y.Z, "
            "the release the copy was taken from"
        )
    new = tags[0]
    if to_arg is not None:
        parsed = parse_version(to_arg)
        if parsed is None:
            raise PlanError(f"--to {to_arg}: expected X.Y.Z")
        new = parsed
    for version in (old, new):
        if version not in tags:
            raise PlanError(f"{TEMPLATE_ROOT} has no tag v{fmt(version)} — run {fetch}")
    if old > new:
        raise PlanError(f"the project ({fmt(old)}) is newer than {fmt(new)}")
    shipped = git(TEMPLATE_ROOT, "show", f"v{fmt(new)}:.claude/ORCHESTRATOR_VERSION")
    if shipped.returncode != 0 or parse_version(shipped.stdout.decode()) != new:
        raise PlanError(
            f"{TEMPLATE_ROOT} is not a claude-code-orchestrator clone (its tag "
            f"v{fmt(new)} does not ship .claude/ORCHESTRATOR_VERSION {fmt(new)}) — "
            "run this script from a template clone"
        )
    return old, new, source


def plan(project: Path, from_arg: str | None, to_arg: str | None) -> int:
    if not (project / ".claude").is_dir():
        raise PlanError(
            f"{project} has no .claude/ — pass the project's root directory"
        )
    old, new, source = resolve_versions(project, from_arg, to_arg)
    old_tree, new_tree = tree(f"v{fmt(old)}"), tree(f"v{fmt(new)}")
    hashes = {rel: blob_sha(path) for rel, path in project_files(project).items()}
    classes, unchanged = classify(old_tree, new_tree, hashes)

    print(f"upgrade plan: {fmt(old)} -> {fmt(new)} (read-only, nothing is changed)")
    print(f"project:  {project}")
    print(f"template: {TEMPLATE_ROOT}")
    print(f"old version from {source}")
    print(f"\nNOOP: {unchanged} files already match {fmt(new)} (not listed)")
    for name, meaning in CLASSES:
        paths = classes[name]
        if not paths:
            continue
        print(f"\n{name} ({len(paths)}) — {meaning}")
        if name == "PROJECT-ONLY":
            print_project_only(paths, release_tags(TEMPLATE_ROOT))
            continue
        for rel in paths:
            owned = "  [project-owned]" if project_owned(rel) else ""
            script = name == "ADD" and is_script(new_tree[rel])
            print(f"  {rel}{owned}{'  ' + ADD_SCRIPT_NOTE if script else ''}")
    if any(project_owned(rel) for paths in classes.values() for rel in paths):
        print(f"\n{OWNED_NOTE}")
    print_exec_bits(project, new_tree)
    print_hook_registrations(project, classes)
    print_changelog_pointer(old, new)
    return 0


def is_script(blob: Blob) -> bool:
    """Executable in git AND a shebang: the template also tracks plain
    documents as 100755, and those must not be reported."""
    if blob.mode != "100755":
        return False
    return git(TEMPLATE_ROOT, "cat-file", "blob", blob.sha).stdout[:2] == b"#!"


def print_exec_bits(project: Path, new_tree: dict[str, Blob]) -> None:
    """Scripts the new version runs that the project's copy cannot execute.
    Only that direction breaks anything; Windows has no exec bit."""
    if os.name == "nt":
        return
    lost = [
        rel
        for rel, blob in sorted(new_tree.items())
        if (project / rel).is_file()
        and not os.access(project / rel, os.X_OK)
        and is_script(blob)
    ]
    if lost:
        print(
            f"\nEXEC BIT ({len(lost)}) — a script upstream, not executable here: chmod +x"
        )
        for rel in lost:
            print(f"  {rel}")


def print_hook_registrations(project: Path, classes: dict[str, list[str]]) -> None:
    """settings.json hooks whose file is missing now or deleted by this plan:
    a registration without its file makes every edit fail."""
    try:
        text = (project / SETTINGS).read_text(encoding="utf-8")
    except OSError:
        return
    try:
        settings = json.loads(text)
    except ValueError as exc:
        print(f"\nHOOKS — {SETTINGS} is not valid JSON ({exc}); check it by hand")
        return
    deleted = set(classes["DELETE"]) | set(classes["DELETE-MODIFIED"])
    broken = []
    for handlers in settings.get("hooks", {}).values():
        for group in handlers:
            for handler in group.get("hooks", []):
                command = handler.get("command", "")
                if HOOKS_DIR not in command:
                    continue
                rel = HOOKS_DIR + command.split(HOOKS_DIR)[1].split()[0].strip("\"'")
                if not (project / rel).is_file():
                    broken.append(f"  {rel} — registered, but missing in the project")
                elif rel in deleted:
                    broken.append(
                        f"  {rel} — deleted by this plan: remove its registration "
                        "in the same step"
                    )
    if broken:
        print(f"\nHOOKS ({len(broken)}) — registrations in {SETTINGS}")
        print("\n".join(sorted(set(broken))))


def print_changelog_pointer(
    old: tuple[int, int, int], new: tuple[int, int, int]
) -> None:
    """Hand steps live in the CHANGELOG; point at the entries, do not parse them."""
    out = git(TEMPLATE_ROOT, "show", f"v{fmt(new)}:CHANGELOG.md")
    if out.returncode != 0:
        return
    text = out.stdout.decode("utf-8", errors="replace")
    versions = [
        fmt(v)
        for m in ENTRY.finditer(text)
        if old < (v := (int(m[1]), int(m[2]), int(m[3]))) <= new
    ]
    if versions:
        print(
            f"\nCHANGELOG — read the entries {', '.join(versions)} for hand steps: "
            f"git -C {TEMPLATE_ROOT} show v{fmt(new)}:CHANGELOG.md"
        )


def tree(tag: str) -> dict[str, Blob]:
    """Every file `tag` ships under PLAN_SCOPE, path -> (mode, blob sha)."""
    out = git(TEMPLATE_ROOT, "ls-tree", "-r", "-z", tag, "--", *PLAN_SCOPE)
    if out.returncode != 0:
        raise PlanError(f"cannot list {tag}: {out.stderr.decode().strip()[:200]}")
    entries = {}
    for record in out.stdout.decode("utf-8", errors="surrogateescape").split("\0"):
        if not record:
            continue
        meta, path = record.split("\t", 1)
        mode, kind, sha = meta.split()
        if kind == "blob":
            entries[path] = Blob(mode, sha)
    return entries


def blob_sha(path: Path) -> str:
    """`git hash-object` without filters: the raw bytes, also outside a repo."""
    data = path.read_bytes()
    return hashlib.sha1(b"blob %d\0" % len(data) + data).hexdigest()


def is_runtime(rel: str) -> bool:
    name = rel.rsplit("/", 1)[-1]
    hook_dotfile = rel.startswith(HOOKS_DIR) and rel.count("/") == 2 and name[0] == "."
    return (
        rel.startswith(RUNTIME_PREFIXES)
        or rel in RUNTIME_FILES
        or name.endswith(COMPILED_SUFFIXES)
        or hook_dotfile
    )


def project_files(project: Path) -> dict[str, Path]:
    """The project's files under PLAN_SCOPE, minus runtime state."""
    files = {}
    for top in PLAN_SCOPE[:2]:
        for dirpath, _, filenames in os.walk(project / top):
            for name in filenames:
                path = Path(dirpath, name)
                rel = path.relative_to(project).as_posix()
                if not is_runtime(rel):
                    files[rel] = path
    if (project / "CLAUDE.md").is_file():
        files["CLAUDE.md"] = project / "CLAUDE.md"
    return files


def classify(
    old: dict[str, Blob], new: dict[str, Blob], hashes: dict[str, str]
) -> tuple[dict[str, list[str]], int]:
    """(class -> sorted paths, count of files already matching the new version)."""
    classes: dict[str, list[str]] = {name: [] for name, _ in CLASSES}
    unchanged = 0
    for rel in sorted(set(old) | set(new) | set(hashes)):
        was, now, have = old.get(rel), new.get(rel), hashes.get(rel)
        unmodified = was is not None and have == was.sha
        if have is None:
            if now is None:
                continue
            name = "ADD" if was is None else "ABSENT"
        elif now is None:
            if was is None:
                name = "PROJECT-ONLY"
            else:
                name = "DELETE" if unmodified else "DELETE-MODIFIED"
        elif have == now.sha:
            unchanged += 1
            continue
        elif unmodified:
            name = "REPLACE"
        elif was is not None and was.sha == now.sha:
            name = "KEEP"
        else:
            name = "MERGE"
        classes[name].append(rel)
    return classes, unchanged


def project_owned(rel: str) -> bool:
    for entry in PROJECT_OWNED:
        top_level = entry == "CLAUDE.md" or entry.startswith(".agents/")
        full = entry if top_level else f".claude/{entry}"
        if rel == full:
            return True
        if full.endswith(("*", "/")) and rel.startswith(full.rstrip("*")):
            return True
    return False


def print_project_only(paths: list[str], tags: list[tuple[int, int, int]]) -> None:
    """Group by the newest release that shipped each path — that is how the
    leftovers of earlier upgrades show up."""
    shipped: dict[tuple[int, int, int], set[str]] = {}
    groups: dict[tuple[int, int, int] | None, list[str]] = {}
    for rel in paths:
        last = None
        for tag in tags:
            if tag not in shipped:
                shipped[tag] = set(tree(f"v{fmt(tag)}"))
            if rel in shipped[tag]:
                last = tag
                break
        groups.setdefault(last, []).append(rel)
    for tag in tags:
        if tag in groups:
            print(f"  last shipped in {fmt(tag)} ({len(groups[tag])}):")
            for rel in groups[tag]:
                print(f"    {rel}")
    if None in groups:
        print(f"  never shipped ({len(groups[None])}):")
        for rel in groups[None]:
            owned = "  [project-owned]" if project_owned(rel) else ""
            print(f"    {rel}{owned}")


def main() -> int:
    parser = argparse.ArgumentParser(prog="check")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--check-latest", action="store_true")
    mode.add_argument("--plan", metavar="PROJECT", type=Path)
    parser.add_argument("--from", dest="from_version", metavar="X.Y.Z")
    parser.add_argument("--to", dest="to_version", metavar="X.Y.Z")
    args = parser.parse_args()

    if args.plan is not None:
        try:
            return plan(args.plan.resolve(), args.from_version, args.to_version)
        except PlanError as exc:
            print(f"plan: {exc}", file=sys.stderr)
            return 2
    if args.from_version or args.to_version:
        parser.error("--from and --to go with --plan")

    have = installed()
    if have is None:
        print(
            "installed: unknown — this copy has no .claude/ORCHESTRATOR_VERSION, so it "
            "predates versioning (before v0.1.0) or the file was removed"
        )
    else:
        print(f"installed: {fmt(have)}")

    if not args.check_latest:
        print("latest: not checked — run with --check-latest (needs network to GitHub)")
        return 0

    upstream = os.environ.get("ORCHESTRATOR_UPSTREAM", DEFAULT_UPSTREAM)
    try:
        newest = latest_release(upstream)
    except RuntimeError as exc:
        print(f"latest: unavailable ({exc})")
        return 0
    print(f"latest: {fmt(newest)}")
    if have is not None and have >= newest:
        print("status: up to date")
        return 0
    print(
        "status: a newer release exists — upgrade by the README procedure, not by copying over"
    )
    changelog = os.environ.get("ORCHESTRATOR_CHANGELOG_URL", DEFAULT_CHANGELOG)
    try:
        entries = newer_entries(changelog, have)
    except (OSError, urllib.error.URLError, ValueError) as exc:
        print(f"changes: unavailable ({exc})")
        return 0
    print("\nchanges since the installed version:\n")
    print(entries or "(no changelog entries found)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
