#!/usr/bin/env python3
"""
check — which claude-code-orchestrator release this project's copy came from.

Usage: check [--check-latest]
       check --plan PROJECT [--from X.Y.Z] [--to X.Y.Z]
  (no flag)       the installed version, from .claude/ORCHESTRATOR_VERSION.
                  No network.
  --check-latest  also the newest release upstream and the changelog entries
                  since the installed one. Needs network to GitHub; if that
                  fails (company proxies block it often) it says so and exits 0.
  --plan PROJECT  read-only upgrade plan for the copy in PROJECT. Run THIS
                  script from a template clone with its tags (the project's
                  own copy is the old version). The old version is PROJECT's
                  .claude/ORCHESTRATOR_VERSION (or --from), the new one the
                  highest vX.Y.Z tag of the clone (or --to). Prints a class per
                  file and changes nothing. Exit 2 when a precondition fails.

Environment (for forks and tests):
  ORCHESTRATOR_UPSTREAM       git URL or path of the template repository
  ORCHESTRATOR_CHANGELOG_URL  URL of its CHANGELOG.md (file:// works)
"""

from __future__ import annotations

import argparse
import os
import re
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path

DEFAULT_UPSTREAM = "https://github.com/GunwooYun/claude-code-orchestrator.git"
DEFAULT_CHANGELOG = "https://raw.githubusercontent.com/GunwooYun/claude-code-orchestrator/main/CHANGELOG.md"
TIMEOUT_S = 15
TAG = re.compile(r"refs/tags/v(\d+)\.(\d+)\.(\d+)$")
ENTRY = re.compile(r"^## \[(\d+)\.(\d+)\.(\d+)\]", re.MULTILINE)

# .claude/skills/orchestrator-version/check -> .claude/ -> repository root
CLAUDE_DIR = Path(__file__).resolve().parents[2]
TEMPLATE_ROOT = CLAUDE_DIR.parent
SEMVER = re.compile(r"(\d+)\.(\d+)\.(\d+)")


class PlanError(Exception):
    """A --plan precondition failed; the message tells the user what to do."""


def parse_version(text: str) -> tuple[int, int, int] | None:
    m = SEMVER.fullmatch(text.strip())
    return (int(m[1]), int(m[2]), int(m[3])) if m else None


def installed(claude_dir: Path = CLAUDE_DIR) -> tuple[int, int, int] | None:
    try:
        text = (claude_dir / "ORCHESTRATOR_VERSION").read_text(encoding="utf-8")
    except OSError:
        return None
    return parse_version(text)


def fmt(version: tuple[int, int, int]) -> str:
    return ".".join(str(p) for p in version)


def latest_release(upstream: str) -> tuple[int, int, int]:
    """Highest vX.Y.Z tag, compared numerically. Raises RuntimeError on failure."""
    try:
        out = subprocess.run(
            ["git", "ls-remote", "--tags", "--refs", upstream],
            capture_output=True,
            text=True,
            timeout=TIMEOUT_S,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise RuntimeError(f"cannot reach {upstream}: {exc}") from exc
    if out.returncode != 0:
        raise RuntimeError(f"cannot reach {upstream}: {out.stderr.strip()[:200]}")
    versions = [
        (int(m[1]), int(m[2]), int(m[3]))
        for line in out.stdout.splitlines()
        if (m := TAG.search(line.split("\t")[-1]))
    ]
    if not versions:
        raise RuntimeError(f"no vX.Y.Z release tags at {upstream}")
    return max(versions)


def newer_entries(changelog_url: str, since: tuple[int, int, int] | None) -> str:
    """Changelog sections newer than `since` (all of them when unknown)."""
    with urllib.request.urlopen(changelog_url, timeout=TIMEOUT_S) as response:
        text = response.read().decode("utf-8", errors="replace")
    starts = list(ENTRY.finditer(text))
    kept = []
    for i, m in enumerate(starts):
        version = (int(m[1]), int(m[2]), int(m[3]))
        end = starts[i + 1].start() if i + 1 < len(starts) else len(text)
        if since is None or version > since:
            kept.append(text[m.start() : end].rstrip())
    return "\n\n".join(kept)


def git(root: Path, *args: str) -> subprocess.CompletedProcess[bytes]:
    return subprocess.run(["git", "-C", str(root), *args], capture_output=True)


def release_tags(root: Path) -> list[tuple[int, int, int]]:
    out = git(root, "tag", "--list", "v*")
    if out.returncode != 0:
        raise PlanError(
            f"{root} is not a git repository — run this script from a clone of "
            "the template, not from a copy of .claude/"
        )
    versions = []
    for line in out.stdout.decode("utf-8", errors="replace").splitlines():
        m = SEMVER.fullmatch(line.strip()[1:])
        if line.startswith("v") and m:
            versions.append((int(m[1]), int(m[2]), int(m[3])))
    return sorted(versions, reverse=True)


def resolve_versions(
    project: Path, from_arg: str | None, to_arg: str | None
) -> tuple[tuple[int, int, int], tuple[int, int, int], str]:
    """(old, new, where old came from). Raises PlanError with the fix."""
    tags = release_tags(TEMPLATE_ROOT)
    fetch = f"`git -C {TEMPLATE_ROOT} fetch --tags`"
    if not tags:
        raise PlanError(f"{TEMPLATE_ROOT} has no vX.Y.Z tags — run {fetch}")
    in_file = installed(project / ".claude")
    if from_arg is not None:
        old = parse_version(from_arg)
        if old is None:
            raise PlanError(f"--from {from_arg}: expected X.Y.Z")
        source = "--from"
        if in_file is not None and in_file != old:
            source += f" (overrides the project's file, which says {fmt(in_file)})"
    elif in_file is not None:
        old, source = in_file, "the project's .claude/ORCHESTRATOR_VERSION"
    else:
        raise PlanError(
            f"{project} has no .claude/ORCHESTRATOR_VERSION — pass --from X.Y.Z, "
            "the release the copy was taken from"
        )
    new = tags[0]
    if to_arg is not None:
        parsed = parse_version(to_arg)
        if parsed is None:
            raise PlanError(f"--to {to_arg}: expected X.Y.Z")
        new = parsed
    for version in (old, new):
        if version not in tags:
            raise PlanError(f"{TEMPLATE_ROOT} has no tag v{fmt(version)} — run {fetch}")
    if old > new:
        raise PlanError(f"the project ({fmt(old)}) is newer than {fmt(new)}")
    shipped = git(TEMPLATE_ROOT, "show", f"v{fmt(new)}:.claude/ORCHESTRATOR_VERSION")
    if shipped.returncode != 0 or parse_version(shipped.stdout.decode()) != new:
        raise PlanError(
            f"{TEMPLATE_ROOT} is not a claude-code-orchestrator clone (its tag "
            f"v{fmt(new)} does not ship .claude/ORCHESTRATOR_VERSION {fmt(new)}) — "
            "run this script from a template clone"
        )
    return old, new, source


def plan(project: Path, from_arg: str | None, to_arg: str | None) -> int:
    if not (project / ".claude").is_dir():
        raise PlanError(
            f"{project} has no .claude/ — pass the project's root directory"
        )
    old, new, source = resolve_versions(project, from_arg, to_arg)
    print(f"upgrade plan: {fmt(old)} -> {fmt(new)} (read-only, nothing is changed)")
    print(f"project:  {project}")
    print(f"template: {TEMPLATE_ROOT}")
    print(f"old version from {source}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(prog="check")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--check-latest", action="store_true")
    mode.add_argument("--plan", metavar="PROJECT", type=Path)
    parser.add_argument("--from", dest="from_version", metavar="X.Y.Z")
    parser.add_argument("--to", dest="to_version", metavar="X.Y.Z")
    args = parser.parse_args()

    if args.plan is not None:
        try:
            return plan(args.plan.resolve(), args.from_version, args.to_version)
        except PlanError as exc:
            print(f"plan: {exc}", file=sys.stderr)
            return 2
    if args.from_version or args.to_version:
        parser.error("--from and --to go with --plan")

    have = installed()
    if have is None:
        print(
            "installed: unknown — this copy has no .claude/ORCHESTRATOR_VERSION, so it "
            "predates versioning (before v0.1.0) or the file was removed"
        )
    else:
        print(f"installed: {fmt(have)}")

    if not args.check_latest:
        print("latest: not checked — run with --check-latest (needs network to GitHub)")
        return 0

    upstream = os.environ.get("ORCHESTRATOR_UPSTREAM", DEFAULT_UPSTREAM)
    try:
        newest = latest_release(upstream)
    except RuntimeError as exc:
        print(f"latest: unavailable ({exc})")
        return 0
    print(f"latest: {fmt(newest)}")
    if have is not None and have >= newest:
        print("status: up to date")
        return 0
    print(
        "status: a newer release exists — upgrade by the README procedure, not by copying over"
    )
    changelog = os.environ.get("ORCHESTRATOR_CHANGELOG_URL", DEFAULT_CHANGELOG)
    try:
        entries = newer_entries(changelog, have)
    except (OSError, urllib.error.URLError, ValueError) as exc:
        print(f"changes: unavailable ({exc})")
        return 0
    print("\nchanges since the installed version:\n")
    print(entries or "(no changelog entries found)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
