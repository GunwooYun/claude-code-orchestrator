#!/usr/bin/env python3
"""
field-report — summarise this project's /isolated-review runs for the template's
developers, who cannot see this repository.

Usage: field-report [--include-paths]
Output: Markdown on stdout — facts per run, and blanks for the person to fill in.

What it reads: the report headers in .claude/docs/reviews/ and the transcripts in
.claude/logs/isolated-review/. What it NEVER emits: review text, code, diffs,
file contents or anything that looks like a secret — only counts, verdicts,
costs, timings and the tool set the reviewer actually had. Unless
--include-paths is given, a reason leaves only in a shape run-review is known to
write, its free parts (paths, branch names, CLI text) masked; any other reason,
a non-first-party model id and an MCP tool name are hidden. Decide
--include-paths per repository.

Sending the report is sending it to an outside party. Read it before you do.
"""

from __future__ import annotations

import argparse
import json
import platform
import re
import subprocess
import time
from pathlib import Path

REPORT_REL = ".claude/docs/reviews"
LOG_REL = ".claude/logs/isolated-review"
STACK_MARKERS = {
    "package.json": "node",
    "pyproject.toml": "python",
    "requirements.txt": "python",
    "go.mod": "go",
    "Cargo.toml": "rust",
    "pom.xml": "jvm",
    "build.gradle": "jvm",
    "build.gradle.kts": "jvm",
    "Gemfile": "ruby",
    "pubspec.yaml": "dart",
    "CMakeLists.txt": "c/c++",
    "Makefile": "make",
    "Dockerfile": "docker",
}
# A finding is a top-level list item (`- `, `* `, `1.`, `1)`), continued by
# indented lines; its confidence is the last high/medium/low word at its end.
# Only `- … — high` was counted, so a numbered list read as "no findings" and
# `— confidence: high` as "?" (round-5 review F3).
FINDING_START = re.compile(r"^ ?(?:[-*]|\d+[.)])\s")
CONFIDENCE = re.compile(r"\b(high|medium|low)\b[\W_]*$", re.IGNORECASE)
HIDDEN = "<hidden>"
# Without --include-paths only these shapes leave the machine. Hiding what
# looked like a path was not enough: branch names, `Makefile`, credentials in
# URLs, account numbers in model ids and MCP server names all passed (round-4
# review #6). Each capture group is free text and is masked by the named kind;
# the rest of the pattern is fixed wording. Anything unmatched is <hidden>.
KNOWN_REASONS = [
    (re.compile(pattern), kind)
    for pattern, kind in (
        (r"^(?:probe )?isolation: no init event — cannot confirm the tool set$", ""),
        (
            r"^(?:probe )?isolation: tools granted were (\[.*\]), expected \[.*\]$",
            "tools",
        ),
        (r"^(?:probe )?isolation: slash commands available: (.*)$", "hidden"),
        (r"^probe: timed out$", ""),
        (r"^probe: expected both reads denied, [\w ]+$", ""),
        (r"^probe: a canary's content reached the model$", ""),
        (r"^the review was not started$", ""),
        (r"^no result event — the run did not finish$", ""),
        (r"^run ended as [\w-]+:(.*)$", "hidden"),
        (r"^terminal_reason was (?:'[\w-]*'|None), not 'completed'$", ""),
        (r"^pinned model '\w+' did not run \(modelUsage: (.*)\)$", "hidden"),
        (r"^empty result$", ""),
        (r"^missing section: ## [A-Za-z ]+$", ""),
        (r"^coverage: (.+) not listed$", "path"),
        (r"^coverage: (.+) listed but never read$", "path"),
        (r"^timed out after [\d.]+ min — partial stream kept, not a verdict$", ""),
        (r"^internal error in run-review: \w+:(.*)$", "hidden"),
        (r"^transcript redaction failed:(.*)$", "hidden"),
        (r"^INVALID: the tree changed during the review — .*$", ""),
        (r"^(?:probe )?cli stderr:(.*)$", "hidden"),
        (
            r"^the branch changes the Read denies forwarded to the reviewer (.*)$",
            "hidden",
        ),
        (r"^clean-up: could not remove(.*)$", "hidden"),
        (r"^interrupted by SIG[A-Z]+ — the reviewer was stopped, not a verdict$", ""),
        # Refusals
        (r"^the working tree must be clean \(commit first\):(.*)$", "hidden"),
        (r"^no --base given and origin/HEAD is not set$", ""),
        (r"^HEAD is the merge-base with (.+): nothing to review$", "hidden"),
        (r"^this branch changes the reviewer itself .*$", ""),
        (r"^\d+ changed lines exceeds the \d+-line cap — split the branch$", ""),
        (r"^claude is not on PATH$", ""),
        (r"^--(?:budget|timeout) must be in .*$", ""),
        (r"^git [\w-]+(.*) failed:(.*)$", "hidden"),
    )
]
FIRST_PARTY_MODEL = re.compile(r"^claude-[a-z0-9.-]+(?:\[1m\])?$")
BUILTIN_TOOL = re.compile(r"^[A-Z][A-Za-z]+$")


def root_dir() -> Path:
    out = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True
    )
    return Path(out.stdout.strip()) if out.returncode == 0 else Path.cwd()


def claude_version() -> str:
    try:
        out = subprocess.run(
            ["claude", "--version"], capture_output=True, text=True, timeout=20
        )
    except (OSError, subprocess.TimeoutExpired):
        return "unknown"
    return out.stdout.strip().split(" ")[0] or "unknown"


def stack(root: Path) -> str:
    found = sorted(
        {name for marker, name in STACK_MARKERS.items() if (root / marker).exists()}
    )
    return ", ".join(found) or "unknown"


def hide_reason(text: str, include_paths: bool) -> str:
    """A reason or refusal as it may leave: a known shape, its free parts masked."""
    if include_paths:
        return text
    for pattern, kind in KNOWN_REASONS:
        match = pattern.match(text)
        if not match:
            continue
        kept, last = [], 0
        for i in range(1, (match.lastindex or 0) + 1):
            kept.append(text[last : match.start(i)])
            kept.append(mask(match.group(i), kind))
            last = match.end(i)
        return "".join(kept) + text[last:]
    return HIDDEN


def mask(value: str, kind: str) -> str:
    if kind == "path":
        return "<path>"
    if kind == "tools":
        names = re.findall(r"'([^']*)'", value)
        return "[" + ", ".join(hide_tools(n, False) for n in names) + "]"
    return " " + HIDDEN if value.startswith(" ") else HIDDEN


def hide_model(models: str, include_paths: bool) -> str:
    """First-party ids stay; a cloud ARN or deployment name can hold an account."""
    if include_paths:
        return models
    names = [m.strip() for m in models.split(",")]
    return ", ".join(m if FIRST_PARTY_MODEL.match(m) else HIDDEN for m in names)


def hide_tools(tools: str, include_paths: bool) -> str:
    """Built-in tool names stay; an MCP tool's name carries the server's name."""
    if include_paths or tools == "?":
        return tools
    names = [t.strip() for t in tools.split(",") if t.strip()]
    return ", ".join(t if BUILTIN_TOOL.match(t) else "<mcp tool>" for t in names)


def parse_report(path: Path) -> dict:
    """Header facts, plus finding confidences — the finding text is not kept."""
    text = path.read_text(encoding="utf-8")
    header, _, body = text.partition("\n---\n")
    run: dict = {"file": path.name, "reasons": [], "confidences": []}
    first = header.splitlines()[0] if header else ""
    run["verdict"] = first.rsplit("—", 1)[-1].strip() or "unknown"
    # `-2`, `-3`: a second report in the same second (run-review write_report).
    stamp = re.search(r"(\d{8})-(\d{6})(?:-\d+)?\.md$", path.name)
    run["date"] = (
        f"{stamp.group(1)[:4]}-{stamp.group(1)[4:6]}-{stamp.group(1)[6:]}"
        if stamp
        else "?"
    )
    for line in header.splitlines():
        if line.startswith("- reason: "):
            # A slice, not str.removeprefix (3.9+): adopting projects run
            # this with whatever python3 they have (round-4 review #5).
            run["reasons"].append(line[len("- reason: ") :])
        elif m := re.match(r"- changed: (\d+) files, (\d+) lines, diff (\w+)", line):
            run["files"], run["lines"], run["mode"] = m.group(1), m.group(2), m.group(3)
        elif m := re.match(r"- model: (.*?)  cost: \$([\d.]+)  time: (\d+)s", line):
            run["model"], run["cost"], run["seconds"] = (
                m.group(1),
                m.group(2),
                m.group(3),
            )
        elif m := re.match(r"- transcript: (\S+)", line):
            run["transcript"] = m.group(1)
    findings = (
        body.split("## Findings", 1)[-1].split("\n## ", 1)[0]
        if "## Findings" in body
        else ""
    )
    items: list[str] = []
    for line in findings.splitlines():
        if FINDING_START.match(line):
            items.append(line)
        elif items and line.strip() and line[:1].isspace():
            items[-1] += " " + line.strip()
    for item in items:
        m = CONFIDENCE.search(item)
        run["confidences"].append(m.group(1).lower() if m else "?")
    return run


def parse_transcript(root: Path, rel: str | None) -> dict:
    facts = {"tools": "?", "slash": "?", "reads": 0, "tool_calls": 0, "probe": "?"}
    if not rel:
        return facts
    base = root / rel
    review, probe = base / "review.jsonl", base / "probe.jsonl"
    for kind, path in (("review", review), ("probe", probe)):
        if not path.exists():
            continue
        read_files: set[str] = set()
        denials = None
        # "\n" only: splitlines() also splits on U+2028 inside JSON strings.
        text = path.read_text(encoding="utf-8", errors="replace")
        for line in text.split("\n"):
            try:
                event = json.loads(line)
            except ValueError:
                continue
            if event.get("type") == "system" and event.get("subtype") == "init":
                if kind == "review":
                    facts["tools"] = ", ".join(sorted(event.get("tools") or []))
                    facts["slash"] = str(len(event.get("slash_commands") or []))
            elif event.get("type") == "assistant" and kind == "review":
                for block in event.get("message", {}).get("content", []):
                    if isinstance(block, dict) and block.get("type") == "tool_use":
                        facts["tool_calls"] += 1
                        if block.get("name") == "Read":
                            read_files.add(str(block.get("input", {}).get("file_path")))
            elif event.get("type") == "result":
                # Distinct paths, as run-review judges it: one canary denied
                # twice is not a passed probe (round-5 review F12).
                denials = len(
                    {
                        str((d.get("tool_input") or {}).get("file_path"))
                        for d in event.get("permission_denials") or []
                        if isinstance(d, dict) and d.get("tool_name") == "Read"
                    }
                )
        if kind == "review":
            facts["reads"] = len(read_files)
        elif denials is not None:
            facts["probe"] = "passed" if denials >= 2 else f"{denials} of 2 denied"
    return facts


def refusals(root: Path, include_paths: bool) -> list[str]:
    path = root / LOG_REL / "refusals.jsonl"
    if not path.exists():
        return []
    out = []
    for line in path.read_text(encoding="utf-8", errors="replace").split("\n"):
        try:
            entry = json.loads(line)
        except ValueError:
            continue
        out.append(
            f"{entry.get('time', '?')}: {hide_reason(str(entry.get('reason', '')), include_paths)}"
        )
    return out


def main() -> int:
    parser = argparse.ArgumentParser(prog="field-report")
    parser.add_argument("--include-paths", action="store_true")
    args = parser.parse_args()
    root = root_dir()
    reports = sorted((root / REPORT_REL).glob("*.md"))
    runs = [parse_report(p) for p in reports]
    refused = refusals(root, args.include_paths)

    print("# Field report — /isolated-review\n")
    print(
        f"generated {time.strftime('%Y-%m-%d')} · Claude Code {claude_version()} · "
        f"{platform.system()} {platform.release()} · stack: {stack(root)}"
    )
    counts = {
        v: sum(1 for r in runs if r["verdict"] == v)
        for v in ("COMPLETE", "INCOMPLETE", "FAILED", "INVALID")
    }
    print(
        f"runs: {len(runs)} ({', '.join(f'{k} {v}' for k, v in counts.items())}) · "
        f"refusals: {len(refused)} · paths {'shown' if args.include_paths else 'hidden'}\n"
    )
    if not runs and not refused:
        print("There are no isolated-review runs in this repository yet.")
        return 0

    print("## Runs\n")
    print(
        "| # | date | verdict | files | lines | diff | model | cost | time | tools granted | slash | probe | files read | tool calls | findings h/m/l |"
    )
    print("|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|")
    for i, run in enumerate(runs, 1):
        t = parse_transcript(root, run.get("transcript"))
        conf = run["confidences"]
        hml = f"{conf.count('high')}/{conf.count('medium')}/{conf.count('low')}"
        model = hide_model(run.get("model", "?"), args.include_paths)
        tools = hide_tools(t["tools"], args.include_paths)
        print(
            f"| {i} | {run['date']} | {run['verdict']} | {run.get('files', '?')} | "
            f"{run.get('lines', '?')} | {run.get('mode', '?')} | {model} | "
            f"${run.get('cost', '?')} | {run.get('seconds', '?')}s | {tools} | {t['slash']} | "
            f"{t['probe']} | {t['reads']} | {t['tool_calls']} | {hml} |"
        )
    reasons = [(i, r) for i, run in enumerate(runs, 1) for r in run["reasons"]]
    if reasons:
        print("\n### Reasons (runs that were not COMPLETE)\n")
        for i, reason in reasons:
            print(f"- #{i}: {hide_reason(reason, args.include_paths)}")
    if refused:
        print("\n### Refusals\n")
        for entry in refused:
            print(f"- {entry}")

    print("\n## Your judgement — no code, no file contents, no secrets\n")
    print(
        "Open each local report in .claude/docs/reviews/ and judge its findings there.\n"
    )
    for i, run in enumerate(runs, 1):
        print(f"### Run #{i} ({run['date']}, {run['verdict']})\n")
        if run["confidences"]:
            print(
                "| finding | confidence | real / false / unsure | one-line summary (no code) |"
            )
            print("|---|---|---|---|")
            for j, conf in enumerate(run["confidences"], 1):
                print(f"| F{j} | {conf} |  |  |")
        else:
            print("No findings reported.")
        print(
            "\n- Missed issues (found later, or by a person-opened review of the same change):"
        )
        print("- Compared with a person-opened (A2) review? What differed:")
        print("- Useful? (one line):")
        # The over-redaction decision (F8) is revisited only on this evidence.
        # Not the marker's literal text: this output must never contain it
        # (test_it_never_carries_review_text_code_or_secrets).
        print(
            "- A hidden value in the report kept you from judging a finding? "
            "Kind of value only, never the value:"
        )
        print("- Friction or odd behaviour:\n")
    print("## Template-wide observations (optional)\n")
    print(
        "- /initproject:\n- /feature:\n- hooks, gates, permissions:\n- anything else:"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
