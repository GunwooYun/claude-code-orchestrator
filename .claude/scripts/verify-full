#!/bin/sh
# Contract: .claude/scripts/README.md — full tier. Unbounded. Never called by a
# hook; CI or a person runs this.
#
# THIS REPOSITORY'S IMPLEMENTATION. A template repository's slowest meaningful
# check is not a longer test run — it is whether the template still describes
# itself truthfully. So this tier adds consistency checks over the instructions.
set -u

echo "== unit tier =="
.claude/scripts/verify-unit || exit 1

echo
echo "== every hook on disk is registered in settings.json =="
missing=0
for hook in .claude/hooks/*.py; do
    name=$(basename "$hook")
    grep -q "$name" .claude/settings.json || {
        echo "  NOT REGISTERED: $name" >&2
        missing=1
    }
done
[ "$missing" -eq 0 ] && echo "  ok"

echo
echo "== every skill's directory name matches its frontmatter name =="
mismatch=0
for skill in .claude/skills/*/SKILL.md; do
    dir=$(basename "$(dirname "$skill")")
    declared=$(sed -n 's/^name: *//p' "$skill" | head -1)
    [ "$dir" = "$declared" ] || {
        echo "  MISMATCH: directory $dir declares name '$declared'" >&2
        mismatch=1
    }
done
[ "$mismatch" -eq 0 ] && echo "  ok"

echo
echo "== instructions do not reference input files that do not exist =="
# Scope: references to files the model is told to READ — rules, skills, agents,
# hooks, scripts. Outputs are excluded on purpose: .claude/docs/, .claude/logs/
# and .claude/checkpoints/ hold what a skill CREATES, often with a date or
# placeholder in the name, so their absence is not a defect.
#
# This is the check that catches the hazard CLAUDE.md warns about: renaming a
# hook without updating what points at it.
#
# \b after the extension matters — without it ".jsonl" matches as ".json" and
# every log reference looks dangling.
dangling=0
for ref in $(grep -rhoE '\.claude/(rules|skills|agents|hooks|scripts)/[A-Za-z0-9_./-]+\.(md|py|json|toml)\b' \
        CLAUDE.md README.md .claude/rules .claude/skills .claude/agents \
        .claude/scripts/README.md .claude/docs/DESIGN.md 2>/dev/null \
        | sort -u); do
    [ -e "$ref" ] || { echo "  DANGLING: $ref" >&2; dangling=1; }
done
[ "$dangling" -eq 0 ] && echo "  ok"

echo
echo "== the four verification scripts honour their contract =="
contract=0
for tier in save task unit full; do
    script=".claude/scripts/verify-$tier"
    if [ ! -f "$script" ]; then
        echo "  MISSING (that tier is unconfigured): verify-$tier"
        continue
    fi
    [ -x "$script" ] || { echo "  NOT EXECUTABLE: $script" >&2; contract=1; }
    head -1 "$script" | grep -q '^#!' || { echo "  NO SHEBANG: $script" >&2; contract=1; }
done
if [ -x .claude/scripts/verify-save ]; then
    # Must be silent AND successful on input it does not handle.
    if ! out=$(.claude/scripts/verify-save .claude/scripts/README.md 2>&1); then
        echo "  verify-save failed on a file it should ignore" >&2
        contract=1
    elif [ -n "$out" ]; then
        echo "  verify-save printed output for a file it should ignore: $out" >&2
        contract=1
    fi
    .claude/scripts/verify-save >/dev/null 2>&1 || {
        echo "  verify-save failed with no argument (must exit 0)" >&2
        contract=1
    }
fi
[ "$contract" -eq 0 ] && echo "  ok"

echo
[ "$missing" -eq 0 ] && [ "$mismatch" -eq 0 ] && [ "$dangling" -eq 0 ] && [ "$contract" -eq 0 ] \
    && { echo "verify-full: all checks passed"; exit 0; }
echo "verify-full: FAILED" >&2
exit 1
