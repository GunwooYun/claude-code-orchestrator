#!/bin/sh
# Report whether Antigravity CLI (agy) is usable right now.
#
# Lives in .claude/bin/, not .claude/scripts/ — that directory is the project's
# verification contract and nothing else belongs in it.
#
# Usage: agy-probe [--quiet]
#
# Exit 0  -> usable. First stdout word: READY
# Exit 1  -> not usable. First stdout word says which state and what to do:
#              MISSING          agy is not on PATH: install it
#              UNAUTHENTICATED  installed but no valid session: log in
#              DEGRADED         answered, but the answer was empty (soft-deny,
#                               quota, or network) — treat as unusable for now
#              STALE            a tier slug in the Model policy table is not
#                               offered by `agy models`: pick slugs again
#                               (/initproject Step 3c)
#
# Callers gate on the exit code and read the word to pick the remedy. The states
# exist because the remedies differ: installing, logging in and waiting are three
# different asks, and the previous template collapsed them into "agy is not
# installed, note it".
set -u

quiet=0
[ "${1:-}" = "--quiet" ] && quiet=1

say() {
    [ "$quiet" -eq 1 ] && return 0
    printf '%s\n' "$1"
}

if ! command -v agy >/dev/null 2>&1; then
    say "MISSING"
    say "agy is not on PATH. Install Antigravity CLI, then run: agy  (and log in)."
    exit 1
fi

# Capture stderr in an unpredictable file. A path built from the PID is
# guessable, and the redirection follows a symlink planted there, so anything
# this process can write becomes writable through it.
errfile=$(mktemp "${TMPDIR:-/tmp}/agy-probe.XXXXXX" 2>/dev/null) || {
    say "DEGRADED"
    say "could not create a temporary file for agy's stderr."
    exit 1
}
trap 'rm -f "$errfile"' EXIT HUP INT TERM

# The Model policy table is the only place a slug is written; the probe reads it
# rather than carrying a copy that goes stale on its own.
rules="$(dirname "$0")/../rules/antigravity-delegation.md"
rows=$(grep -E '^\| T[1-4] ' "$rules" 2>/dev/null)
slug_re='gemini-[0-9a-z.-]+-(low|medium|high)'
t1=$(printf '%s\n' "$rows" | grep -E '^\| T1 ' | grep -oE "$slug_re" | head -n 1)
if [ -z "$t1" ]; then
    say "DEGRADED"
    say "no T1 slug in the Model policy table of $rules."
    exit 1
fi

# Every tier's slug against what agy offers, BEFORE the call: when the T1 slug
# itself is gone the call below fails, and reading that as DEGRADED sent people
# to wait for something that never recovers (2026-10-13, agy 1.3.3 dropped every
# slug the table named). Lines are `slug<TAB>display name`; a listing without
# that shape (an older agy, a failure) skips the check rather than passing it.
offered=$(agy models 2>/dev/null | awk -F '\t' 'NF >= 2 { print $1 }')
missing=""
if [ -n "$offered" ]; then
    for tier in 1 2 3 4; do
        for slug in $(printf '%s\n' "$rows" | grep -E "^\| T$tier " | grep -oE "$slug_re"); do
            printf '%s\n' "$offered" | grep -qxF "$slug" || missing="$missing T$tier:$slug"
        done
    done
fi
if [ -n "$missing" ]; then
    say "STALE"
    for entry in $missing; do
        say "${entry%%:*} names ${entry#*:}, which agy does not offer."
    done
    say "agy offers: $(printf '%s\n' "$offered" | grep '^gemini-' | tr '\n' ' ')"
    say "Pick the tier slugs again (/initproject Step 3c), then re-run the probe."
    exit 1
fi

# One cheap call on the cheapest tier. Ask for an exact token so an empty or
# hedged answer is detectable — a soft-denied call exits 0 with no content, which
# is the trap documented in .claude/docs/research/antigravity-cli.md (§3).
output=$(agy -p "Reply with exactly: PROBE_OK" \
    --model "$t1" \
    --print-timeout 60s 2>"$errfile" )
status=$?
stderr=$(cat "$errfile" 2>/dev/null)

# A usable answer settles it. This check comes FIRST: the patterns below are
# matched against diagnostics too, and agy writes warnings, quota notices and
# retry lines to stderr on calls that worked. Matching those first reported
# UNAUTHENTICATED for a healthy session, sending every caller down the fallback
# path with a remedy the user could not act on.
case "$output" in
    *PROBE_OK*)
        say "READY"
        [ -z "$offered" ] && say "note: could not list agy's models; tier slugs not checked."
        [ -n "$stderr" ] && say "note: agy wrote to stderr: $stderr"
        exit 0
        ;;
esac

# The call did not work. The patterns below only choose WHICH unusable state to
# report — UNAUTHENTICATED (log in) rather than DEGRADED (wait) — so a loose
# match costs a less precise remedy, not a false success. Authentication errors
# are worded differently across versions, so match words rather than exit codes.
# Status codes are matched with their surrounding text: a bare *401* also matched
# any answer containing those three digits in a row.
case "$output$stderr" in
    *[Uu]nauthenticated*|*"not logged in"*|*"log in"*|*"login"*|*"credential"*|\
    *"API key"*|*"authenticate"*|*"auth error"*|\
    *"401 "*|*"401:"*|*"403 "*|*"403:"*|*"HTTP 401"*|*"HTTP 403"*)
        say "UNAUTHENTICATED"
        say "agy is installed but has no valid session. Run: agy  then log in."
        exit 1
        ;;
esac

say "DEGRADED"
if [ "$status" -ne 0 ]; then
    say "agy exited $status. stderr: ${stderr:-<empty>}"
else
    say "agy exited 0 but returned no usable answer (soft-deny, quota, or network)."
    say "stderr: ${stderr:-<empty>}"
fi
exit 1
